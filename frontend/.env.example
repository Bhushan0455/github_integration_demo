# ============================================
# GitHub Integration Demo — Frontend Environment Variables
# ============================================
# INSTRUCTIONS:
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below
# 3. Vite requires env vars to start with VITE_ to be accessible in the browser

# Backend API URL (where FastAPI is running)
VITE_BACKEND_URL=http://localhost:8000

# Your GitHub App slug (the URL-friendly name of your GitHub App)
# Find it at: https://github.com/settings/apps → your app → the slug in the URL
VITE_GITHUB_APP_SLUG=your-github-app-slug
