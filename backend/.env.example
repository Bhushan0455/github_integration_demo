# ============================================
# GitHub Integration Demo — Environment Variables
# ============================================
# INSTRUCTIONS:
# 1. Copy this file:       cp .env.example .env
# 2. Fill in your values below
# 3. Never commit the .env file to git!

# ── GitHub OAuth App (for user login) ──────────
# Create one at: https://github.com/settings/developers
# → "New OAuth App"
# → Homepage URL: http://localhost:5173
# → Callback URL: http://localhost:8000/auth/callback
GITHUB_CLIENT_ID=your_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_oauth_app_client_secret

# ── GitHub App (for repo access & webhooks) ────
# Create one at: https://github.com/settings/apps
# → "New GitHub App"
# → Homepage URL: http://localhost:5173
# → Setup URL: http://localhost:5173/callback/install
# → Webhook URL: https://<your-subdomain>.ngrok-free.app/webhook/github
# → Webhook secret: choose any random string
# → Permissions: Repository → Contents: Read
# → Subscribe to events: Push
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Path to the .pem private key file downloaded from your GitHub App settings.
# Go to your GitHub App → General → Private keys → Generate a private key
# Save the downloaded .pem file in the backend/ folder
GITHUB_PRIVATE_KEY_PATH=./private-key.pem

# Alternatively, paste the entire PEM key as a string (useful for deployment):
# GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----

# ── Database ───────────────────────────────────
# SQLite file will be created automatically in the backend/ folder
DATABASE_URL=sqlite:///./github_demo.db

# ── Frontend URL ───────────────────────────────
# Where the React frontend is running
FRONTEND_URL=http://localhost:5173
